.DS_Store
.venv/
__pycache__/
.ipynb_checkpoints/
*.pyc
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/simple_reproduction/*.parquet
reports/simple_reproduction/*.joblib
reports/simple_reproduction/*.npz

# Large raw payloads stay local; acquisition scripts and guides stay versioned.
data/raw/**/*.csv
data/raw/**/*.zip
data/raw/**/*.part
data/raw/weather/stations/*.geojson

# Archived raw payloads remain local; archive manifests stay versioned.
data/archive/**/*.csv
data/archive/**/*.zip
data/archive/**/*.parquet
data/archive/**/*.part
