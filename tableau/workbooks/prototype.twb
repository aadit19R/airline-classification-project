<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="18.1" source-platform="mac" version="18.1" source-build="2026.2.2 (20262.26.0819.2015)">
  <datasources>
    <datasource caption="Model performance" inline="true" name="performance" version="18.1">
      <connection class="hyper" dbname="Data/prototype.hyper" schema="Extract" tablename="Extract" access_mode="readonly" default-settings="hyper">
        <relation name="Extract" table="[Extract].[Extract]" type="table"/>
      </connection>
      <column name="[model_id]" datatype="string" role="dimension" type="nominal"/>
      <column name="[f1]" datatype="real" role="measure" type="quantitative"/>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="F1 comparison">
      <table>
        <view>
          <datasources>
            <datasource name="performance" caption="Model performance"/>
          </datasources>
          <datasource-dependencies datasource="performance">
            <column name="[model_id]" datatype="string" role="dimension" type="nominal"/>
            <column name="[f1]" datatype="real" role="measure" type="quantitative"/>
            <column-instance column="[model_id]" derivation="None" name="[none:model_id:nk]" pivot="key" type="nominal"/>
            <column-instance column="[f1]" derivation="Avg" name="[avg:f1:qk]" pivot="key" type="quantitative"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane>
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
          </pane>
        </panes>
        <rows>[performance].[none:model_id:nk]</rows>
        <cols>[performance].[avg:f1:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="01 Model performance">
      <style/>
      <size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200"/>
      <zones>
        <zone h="100000" w="100000" x="0" y="0" id="1" name="F1 comparison"/>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="30">
    <window class="dashboard" name="01 Model performance" maximized="true">
      <viewpoints>
        <viewpoint name="F1 comparison">
          <zoom type="entire-view"/>
        </viewpoint>
      </viewpoints>
      <active id="-1"/>
    </window>
  </windows>
</workbook>
