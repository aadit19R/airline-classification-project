<?xml version='1.0' encoding='UTF-8'?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="18.1" source-platform="mac" source-build="2026.2.2 (20262.26.0819.2015)" version="18.1">
  <preferences>
    <preference name="ui.encoding.shelf.height" value="24"/>
  </preferences>
  <datasources>
    <datasource name="Parameters" hasconnection="false" inline="true" version="18.1">
      <column caption="Model" datatype="string" name="[Model]" param-domain-type="list" role="measure" type="nominal" value="&quot;Logistic Regression ★&quot;">
        <calculation class="tableau" formula="&quot;Logistic Regression ★&quot;"/>
        <members>
          <member value="&quot;Logistic Regression ★&quot;"/>
          <member value="&quot;KNN&quot;"/>
          <member value="&quot;SVM&quot;"/>
          <member value="&quot;Random Forest&quot;"/>
        </members>
      </column>
      <column caption="Error metric" datatype="string" name="[Error metric]" param-domain-type="list" role="measure" type="nominal" value="&quot;False-positive rate&quot;">
        <calculation class="tableau" formula="&quot;False-positive rate&quot;"/>
        <members>
          <member value="&quot;Precision&quot;"/>
          <member value="&quot;Recall&quot;"/>
          <member value="&quot;Miss rate&quot;"/>
          <member value="&quot;False-positive rate&quot;"/>
        </members>
      </column>
      <column caption="Review quota (%)" datatype="integer" name="[Review quota (%)]" param-domain-type="list" role="measure" type="quantitative" value="10">
        <calculation class="tableau" formula="10"/>
        <members>
          <member value="5"/>
          <member value="10"/>
          <member value="20"/>
        </members>
      </column>
      <column caption="List airport" datatype="string" name="[List airport]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
        <calculation class="tableau" formula="&quot;All&quot;"/>
        <members>
          <member value="&quot;All&quot;"/>
          <member value="&quot;ATL&quot;"/>
          <member value="&quot;DFW&quot;"/>
          <member value="&quot;ORD&quot;"/>
        </members>
      </column>
    </datasource>
