  <windows source-height="30">
    <window class="dashboard" name="01 Model performance" maximized="true">
      <viewpoints>
        <viewpoint name="Selected display model · July results">
          <zoom type="entire-view"/>
        </viewpoint>
        <viewpoint name="F1 · four models and baselines">
          <zoom type="entire-view"/>
