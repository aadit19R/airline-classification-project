      <column caption="Prediction Cutoff Utc" datatype="string" name="[prediction_cutoff_utc]" role="dimension" type="nominal"/>
      <column caption="Origin" datatype="string" name="[origin]" role="dimension" type="nominal"/>
      <column caption="Destination" datatype="string" name="[destination]" role="dimension" type="nominal"/>
      <column caption="Reporting Airline" datatype="string" name="[reporting_airline]" role="dimension" type="nominal"/>
      <column caption="Departure Time Band" datatype="string" name="[departure_time_band]" role="dimension" type="nominal"/>
      <column caption="Run Id" datatype="string" name="[run_id]" role="dimension" type="nominal"/>
      <column caption="Model Version" datatype="string" name="[model_version]" role="dimension" type="nominal"/>
      <column caption="Model Id" datatype="string" name="[model_id]" role="dimension" type="nominal"/>
      <column caption="Feature Set" datatype="string" name="[feature_set]" role="dimension" type="nominal"/>
      <column caption="Split" datatype="string" name="[split]" role="dimension" type="nominal"/>
      <column caption="Cohort Id" datatype="string" name="[cohort_id]" role="dimension" type="nominal"/>
      <column caption="Candidate Id" datatype="string" name="[candidate_id]" role="dimension" type="nominal"/>
      <column caption="Threshold Policy" datatype="string" name="[threshold_policy]" role="dimension" type="nominal"/>
      <column caption="Y True" datatype="integer" name="[y_true]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Risk Score" datatype="real" name="[risk_score]" role="measure" type="quantitative"/>
      <column caption="Decision Threshold" datatype="real" name="[decision_threshold]" role="measure" type="quantitative"/>
      <column caption="Score Type" datatype="string" name="[score_type]" role="dimension" type="nominal"/>
      <column caption="Y Pred" datatype="integer" name="[y_pred]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Confusion Label" datatype="string" name="[confusion_label]" role="dimension" type="nominal"/>
      <column caption="Is Validation Selected" datatype="boolean" name="[is_validation_selected]" role="dimension" type="nominal"/>
      <column caption="Ranking Tie Key" datatype="string" name="[ranking_tie_key]" role="dimension" type="nominal"/>
      <column caption="Risk Rank" datatype="integer" name="[risk_rank]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Rank Cohort Id" datatype="string" name="[rank_cohort_id]" role="dimension" type="nominal"/>
      <column caption="Rank Cohort Size" datatype="integer" name="[rank_cohort_size]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Model" datatype="string" name="[Model]" role="dimension" type="nominal"/>
      <column caption="Rank Label" datatype="string" name="[Rank label]" role="dimension" type="nominal"/>
      <column caption="Flight Detail" datatype="string" name="[Flight detail]" role="dimension" type="nominal"/>
      <column name="[Keep review]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[feature_set] = &quot;B&quot; AND [Model] = [Parameters].[Model] AND [risk_rank] &lt;= CEILING([Parameters].[Review quota (%)] / 100.0 * [rank_cohort_size]) AND ([Parameters].[List airport] = &quot;All&quot; OR [origin] = [Parameters].[List airport])"/>
      </column>
      <column name="[Keep errors]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[feature_set] = &quot;B&quot; AND [Model] = [Parameters].[Model] AND ([confusion_label] = &quot;FP&quot; OR [confusion_label] = &quot;FN&quot;) AND ([Parameters].[List airport] = &quot;All&quot; OR [origin] = [Parameters].[List airport])"/>
      </column>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" show-structure="true" dim-percentage="0.5" measure-percentage="0.5"/>
    </datasource>
