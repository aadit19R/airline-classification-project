      <column caption="Cohort Id" datatype="string" name="[cohort_id]" role="dimension" type="nominal"/>
      <column caption="Candidate Id" datatype="string" name="[candidate_id]" role="dimension" type="nominal"/>
      <column caption="Capacity Fraction" datatype="real" name="[capacity_fraction]" role="measure" type="quantitative" default-format="p0.0%"/>
      <column caption="N Flights" datatype="integer" name="[n_flights]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Actual Positive" datatype="integer" name="[actual_positive]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Reviewed Flights" datatype="integer" name="[reviewed_flights]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Realized Review Fraction" datatype="real" name="[realized_review_fraction]" role="measure" type="quantitative"/>
      <column caption="Captured Delays" datatype="real" name="[captured_delays]" role="measure" type="quantitative"/>
      <column caption="False Alerts" datatype="real" name="[false_alerts]" role="measure" type="quantitative"/>
      <column caption="Capture Recall" datatype="real" name="[capture_recall]" role="measure" type="quantitative" default-format="p0.0%"/>
      <column caption="Review Precision" datatype="real" name="[review_precision]" role="measure" type="quantitative" default-format="p0.0%"/>
      <column caption="Lift Over Prevalence" datatype="real" name="[lift_over_prevalence]" role="measure" type="quantitative"/>
      <column caption="Random Expected Recall" datatype="real" name="[random_expected_recall]" role="measure" type="quantitative"/>
      <column caption="Random Expected Precision" datatype="real" name="[random_expected_precision]" role="measure" type="quantitative"/>
      <column caption="Cohort Fingerprint" datatype="string" name="[cohort_fingerprint]" role="dimension" type="nominal"/>
      <column caption="Model" datatype="string" name="[Model]" role="dimension" type="nominal"/>
      <column name="[Keep quota]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[capacity_fraction] = [Parameters].[Review quota (%)] / 100.0"/>
      </column>
      <column name="[Keep curve]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Model] = [Parameters].[Model] OR [Model] = &quot;Historical risk&quot; OR [Model] = &quot;Random expectation&quot;"/>
      </column>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" show-structure="true" dim-percentage="0.5" measure-percentage="0.5"/>
    </datasource>
    <datasource name="quota_summary" caption="Quota Summary" inline="true" version="18.1">
      <connection class="hyper" dbname="Data/quota_summary.hyper" schema="Extract" tablename="Extract" access-mode="readonly" default-settings="hyper">
        <relation name="Extract" table="[Extract].[Extract]" type="table"/>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>Model</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Model]</local-name>
            <parent-name>[Extract]</parent-name>
            <remote-alias>Model</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>Capacity</remote-name>
            <remote-type>20</remote-type>
            <local-name>[Capacity]</local-name>
            <parent-name>[Extract]</parent-name>
            <remote-alias>Capacity</remote-alias>
            <ordinal>1</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>Summary</remote-name>
            <remote-type>129</remote-type>
            <local-name>[Summary]</local-name>
            <parent-name>[Extract]</parent-name>
            <remote-alias>Summary</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <column caption="Model" datatype="string" name="[Model]" role="dimension" type="nominal"/>
      <column caption="Capacity" datatype="integer" name="[Capacity]" role="measure" type="quantitative" default-format="n#,##0"/>
      <column caption="Summary" datatype="string" name="[Summary]" role="dimension" type="nominal"/>
      <column name="[Keep]" datatype="boolean" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Model] = [Parameters].[Model] AND [Capacity] = [Parameters].[Review quota (%)]"/>
      </column>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" show-structure="true" dim-percentage="0.5" measure-percentage="0.5"/>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="F1 · four models and baselines">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="12" bold="true" fontcolor="#20344D">F1 · four models and baselines</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="model_metrics" caption="Model Metrics"/>
          </datasources>
          <datasource-dependencies datasource="model_metrics">
            <column caption="Model" datatype="string" name="[Model]" role="dimension" type="nominal"/>
            <column-instance column="[Model]" derivation="None" name="[none:Model:nk]" pivot="key" type="nominal"/>
            <column caption="F1" datatype="real" name="[f1]" role="measure" type="quantitative" default-format="n0.000"/>
            <column-instance column="[f1]" derivation="Avg" name="[avg:f1:qk]" pivot="key" type="quantitative"/>
            <column name="[Compare]" datatype="boolean" role="dimension" type="nominal">
              <calculation class="tableau" formula="[feature_set] = &quot;B&quot; OR NOT ([feature_set] = &quot;A&quot; OR [feature_set] = &quot;reference66&quot;)"/>
            </column>
            <column-instance column="[Compare]" derivation="None" name="[none:Compare:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Model" datatype="string" name="[Model]" param-domain-type="list" role="measure" type="nominal" value="&quot;Logistic Regression ★&quot;">
              <calculation class="tableau" formula="&quot;Logistic Regression ★&quot;"/>
              <members>
                <member value="&quot;Logistic Regression ★&quot;"/>
                <member value="&quot;KNN&quot;"/>
                <member value="&quot;SVM&quot;"/>
                <member value="&quot;Random Forest&quot;"/>
              </members>
            </column>
            <column caption="Error metric" datatype="string" name="[Error metric]" param-domain-type="list" role="measure" type="nominal" value="&quot;False-positive rate&quot;">
              <calculation class="tableau" formula="&quot;False-positive rate&quot;"/>
              <members>
                <member value="&quot;Precision&quot;"/>
                <member value="&quot;Recall&quot;"/>
                <member value="&quot;Miss rate&quot;"/>
                <member value="&quot;False-positive rate&quot;"/>
              </members>
            </column>
            <column caption="Review quota (%)" datatype="integer" name="[Review quota (%)]" param-domain-type="list" role="measure" type="quantitative" value="10">
              <calculation class="tableau" formula="10"/>
              <members>
                <member value="5"/>
                <member value="10"/>
                <member value="20"/>
              </members>
            </column>
            <column caption="List airport" datatype="string" name="[List airport]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;"/>
              <members>
                <member value="&quot;All&quot;"/>
                <member value="&quot;ATL&quot;"/>
                <member value="&quot;DFW&quot;"/>
                <member value="&quot;ORD&quot;"/>
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[none:Compare:nk]">
            <groupfilter function="member" level="[none:Compare:nk]" member="true"/>
          </filter>
          <aggregation value="true"/>
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial"/>
            <format attr="font-size" value="10"/>
            <format attr="color" value="#3D4A5C"/>
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#FFFFFF"/>
          </style-rule>
          <style-rule element="label">
            <format attr="font-size" value="9"/>
            <format attr="color" value="#3D4A5C"/>
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off"/>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Bar"/>
            <encodings>
              <text column="[model_metrics].[avg:f1:qk]"/>
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true"/>
                <format attr="mark-labels-cull" value="true"/>
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[model_metrics].[none:Model:nk]</rows>
        <cols>[model_metrics].[avg:f1:qk]</cols>
      </table>
