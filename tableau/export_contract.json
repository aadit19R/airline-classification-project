{
  "schema_version": "1.1",
  "status": "implemented_real_evaluation_outputs_available",
  "encoding": "utf-8",
  "null_representation": "empty CSV field; undefined rates remain null",
  "tables": {
    "flight_predictions.csv": {
      "grain": [
        "run_id",
        "split",
        "flight_id",
        "model_id",
        "feature_set"
      ],
      "purpose": "Row-level scored flights, errors and review lists.",
      "fields": {
        "run_id": "string: immutable experiment identifier",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "feature_set": "string: A|B; baseline uses a documented value",
        "split": "string: validation|test",
        "flight_id": "string: stable source identity",
        "flight_date": "ISO date",
        "scheduled_departure_utc": "ISO UTC datetime",
        "prediction_cutoff_utc": "ISO UTC datetime",
        "origin": "string",
        "destination": "string",
        "reporting_airline": "string",
        "departure_time_band": "string",
        "y_true": "integer: 0|1",
        "risk_score": "number: higher means greater predicted delay risk",
        "score_type": "string: decision_function|uncalibrated_probability|calibrated_probability|baseline_score",
        "decision_threshold": "number: frozen from validation",
        "y_pred": "integer: 0|1",
        "confusion_label": "string: TP|FP|FN|TN",
        "is_validation_selected": "boolean",
        "ranking_tie_key": "string: reproducible seed/flight hash independent of y_true",
        "rank_cohort_id": "string: explicitly fixed cohort used for ranking",
        "risk_rank": "integer: 1..N within candidate/split/rank cohort, after deterministic tie breaking",
        "rank_cohort_size": "integer: denominator for capacity review-list selection"
      }
    },
    "model_metrics.csv": {
      "grain": [
        "run_id",
        "model_id",
        "feature_set",
        "split",
        "cohort_id"
      ],
      "purpose": "Candidate cards, comparisons and confusion matrix.",
      "fields": {
        "run_id": "string: immutable experiment identifier",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "feature_set": "string: A|B; baseline uses a documented value",
        "split": "string: validation|test",
        "cohort_id": "string: documented fixed evaluation scope",
        "n_flights": "integer",
        "actual_positive": "integer",
        "predicted_positive": "integer",
        "tp": "integer",
        "fp": "integer",
        "fn": "integer",
        "tn": "integer",
        "prevalence": "number|null",
        "precision": "number|null",
        "recall": "number|null",
        "f1": "number|null",
        "average_precision": "number|null",
        "roc_auc": "number|null",
        "accuracy": "number|null",
        "fit_seconds": "number",
        "prediction_seconds": "number",
        "decision_threshold": "number",
        "is_validation_selected": "boolean",
        "cohort_fingerprint": "string: hash of ordered flight IDs and targets",
        "evaluation_scenario": "string: historical_availability_assumptions"
      }
    },
    "feature_comparison.csv": {
      "grain": [
        "run_id",
        "model_id",
        "split",
        "cohort_id",
        "base_feature_set",
        "added_feature_set"
      ],
      "purpose": "Paired A-to-B comparison on identical flights; aircraft rotation excluded.",
      "fields": {
        "run_id": "string",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "split": "string",
        "cohort_id": "string",
        "base_feature_set": "string",
        "added_feature_set": "string",
        "n_common_flights": "integer|null: null if comparison unavailable",
        "identical_ids_and_labels": "boolean|null: must be true for a completed comparison",
        "cohort_fingerprint": "string",
        "base_average_precision": "number|null",
        "added_average_precision": "number|null",
        "delta_average_precision": "number|null: added minus base",
        "base_f1": "number|null",
        "added_f1": "number|null",
        "delta_f1": "number|null",
        "added_feature_coverage": "number|null: explicitly defined fraction",
        "status": "string: completed|unavailable",
        "unavailable_reason": "string|null"
      }
    },
    "subgroup_metrics.csv": {
      "grain": [
        "run_id",
        "model_id",
        "feature_set",
        "split",
        "cohort_id",
        "group_dimension",
        "group_value"
      ],
      "purpose": "Prediction reliability and error rates with proper denominators.",
      "fields": {
        "run_id": "string: immutable experiment identifier",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "feature_set": "string: A|B; baseline uses a documented value",
        "split": "string: validation|test",
        "cohort_id": "string",
        "group_dimension": "string: origin|reporting_airline|departure_time_band",
        "group_value": "string",
        "n_flights": "integer",
        "actual_positive": "integer",
        "actual_negative": "integer",
        "predicted_positive": "integer",
        "tp": "integer",
        "fp": "integer",
        "fn": "integer",
        "tn": "integer",
        "precision": "number|null",
        "recall": "number|null",
        "false_negative_rate": "number|null",
        "false_positive_rate": "number|null",
        "precision_supported": "boolean",
        "recall_supported": "boolean",
        "false_positive_rate_supported": "boolean"
      }
    },
    "priority_curve.csv": {
      "grain": [
        "run_id",
        "model_id",
        "feature_set",
        "split",
        "cohort_id",
        "capacity_fraction"
      ],
      "purpose": "Risk-prioritization capacity scenarios and baselines.",
      "fields": {
        "run_id": "string: immutable experiment identifier",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "feature_set": "string: A|B; baseline uses a documented value",
        "split": "string: validation|test",
        "cohort_id": "string",
        "capacity_fraction": "number: 0.05|0.10|0.20",
        "n_flights": "integer",
        "actual_positive": "integer",
        "reviewed_flights": "integer: ceil(capacity_fraction*n_flights)",
        "realized_review_fraction": "number",
        "captured_delays": "integer",
        "false_alerts": "integer",
        "capture_recall": "number|null",
        "review_precision": "number|null",
        "lift_over_prevalence": "number|null",
        "random_expected_recall": "number",
        "random_expected_precision": "number|null",
        "ranking_tie_policy": "string: seed/flight hash",
        "cohort_fingerprint": "string"
      }
    },
    "pr_curve.csv": {
      "grain": [
        "run_id",
        "model_id",
        "feature_set",
        "split",
        "cohort_id",
        "point_index"
      ],
      "purpose": "Precision-recall curves from candidate risk scores.",
      "fields": {
        "run_id": "string: immutable experiment identifier",
        "model_id": "string: logistic_regression|knn|svm|random_forest|named_baseline",
        "feature_set": "string: A|B; baseline uses a documented value",
        "split": "string: validation|test",
        "cohort_id": "string",
        "point_index": "integer",
        "threshold": "number|null: curve endpoints may lack threshold",
        "precision": "number",
        "recall": "number",
        "n_flights": "integer",
        "actual_positive": "integer"
      }
    }
  },
  "global_checks": [
    "Unique grain keys in every table",
    "Exact same query IDs and labels across candidate/feature comparisons",
    "TP+FP+FN+TN=n_flights",
    "TP+FN=actual_positive; TP+FP=predicted_positive",
    "Rates reconciled from counts; undefined denominators remain null",
    "All reported model settings and classification thresholds frozen before final scoring",
    "Scores never relabelled as calibrated probabilities without calibration evidence",
    "Only A/B candidates are evaluated; aircraft rotation is excluded from the agreed scope",
    "Export manifest includes checksums, selected candidate, thresholds, source versions and scenario notes",
    "Workbook and manifest identify the historical simulation and unverified input-delivery assumptions"
  ],
  "manifest_file": "export_manifest.json"
}
